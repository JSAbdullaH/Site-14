# Copy this file to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=4000

# Your local PostgreSQL. Replace YOUR_MAC_USER with
# the output of `whoami`. Homebrew and Postgres.app need no password locally.
DATABASE_URL=postgresql://YOUR_MAC_USER@localhost:5432/site14_dev
# Used only by `npm test`. Must be a separate database whose name contains
# "test": the tests wipe it. Never point this at the shared team database.
DATABASE_URL_TEST=postgresql://YOUR_MAC_USER@localhost:5432/site14_test

# At least 32 characters. Generate one with: openssl rand -hex 32
JWT_ACCESS_SECRET=replace-with-output-of-openssl-rand-hex-32
JWT_ACCESS_TTL_SECONDS=900
REQUIRE_EMAIL_VERIFICATION=false
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# Password given to every seeded demo user (dev only)
SEED_PASSWORD=Site14-Demo-2026!
